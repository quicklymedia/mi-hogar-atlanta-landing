# URL pública del sitio (para Open Graph). En Vercel: https://tudominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Integración GoHighLevel ──────────────────────────────────────
# Modo activo: "webhook" (Opción A, default) o "api" (Opción B)
GHL_MODE=webhook

# Opción A (default) · Inbound Webhook de un workflow de GHL
GHL_WEBHOOK_URL=

# Opción B · GHL API v2 (/contacts/upsert) con token de Private Integration
GHL_API_TOKEN=
GHL_LOCATION_ID=
